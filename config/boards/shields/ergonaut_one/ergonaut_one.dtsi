/*
 * SPDX-License-Identifier: MIT
 * Конфигурация для сплит-клавиатуры с 42 клавишами
 * Левая половина: 3 ряда по 6 + 3 клавиши большого пальца = 21 клавиша
 */

#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix_transform = &default_transform;
    };

    default_transform: keymap_transform0 {
        compatible = "zmk,matrix-transform";
        columns = <6>;
        rows = <4>;  /* 4 строки: 3 основных ряда + 1 ряд для клавиш больших пальцев */
        
        /* 
         * Матрица для левой половины (21 клавиша)
         * RC(ряд, столбец)
         * 
         * Ряды 0-2: основные три ряда по 6 клавиш
         * Ряд 3: три клавиши больших пальцев (позиции RC(3,1), RC(3,2), RC(3,3))
         * 
         * NULL - неиспользуемые позиции матрицы
         */
        map = <
            // Ряд 0 (верхний) - 6 клавиш
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)
            
            // Ряд 1 (средний) - 6 клавиш
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)
            
            // Ряд 2 (нижний) - 6 клавиш
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)
            
            // Ряд 3 (клавиши больших пальцев) - 3 клавиши в центре
           RC(3,1) RC(3,2) RC(3,3) 
        >;
    };
};
