#include "ergonaut_one_nice.dtsi"


/ {
    chosen {
        zmk,keyboard-name = "Ergonaut One Dongle";
    };

    /* Включаем поддержку ZMK Studio */
    zmk_studio {
        compatible = "zmk,studio";
        status = "okay";
    };

    /* Донгл физического layout не имеет */
    &physical_layout {
        status = "disabled";
    }

    /* kscan_none для безопасного отключения сканирования */
    kscan_none: kscan_none {
        compatible = "zmk,kscan-none";
        status = "okay";
    }

    /* пустой transform, если Studio требует node */
    noop_transform: noop_transform {
        compatible = "zmk,physical-layout-transform";
        map = <>;
    };

&pro_micro_i2c {   
    status = "okay";

    oled: ssd1306@3c {
        compatible = "sinowealth,sh1106";
        reg = <0x3c>;
        width = <128>;
        height = <64>;
        segment-offset = <2>;
        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <63>;
        prechargep = <0x22>;
        inversion-on;
    };
};
