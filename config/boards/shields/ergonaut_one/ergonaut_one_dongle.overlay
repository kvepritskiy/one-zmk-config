    };
    kp30: keypos@30 {
        compatible = "zmk,key-position-v2";
        #key-cells = <1>;
        key-position = <200 20>;
    };
    kp31: keypos@31 {
        compatible = "zmk,key-position-v2";
        #key-cells = <1>;
        key-position = <220 20>;
    };
    kp32: keypos@32 {
        compatible = "zmk,key-position-v2";
        #key-cells = <1>;
        key-position = <240 20>;
    };

    kp33: keypos@33 {
        compatible = "zmk,key-position-v2";
        #key-cells = <1>;
        key-position = <140 40>;
    };
    kp34: keypos@34 {
        compatible = "zmk,key-position-v2";
        #key-cells = <1>;
        key-position = <160 40>;
    };
    kp35: keypos@35 {
        compatible = "zmk,key-position-v2";
        #key-cells = <1>;
        key-position = <180 40>;
    };
    kp36: keypos@36 {
        compatible = "zmk,key-position-v2";
        #key-cells = <1>;
        key-position = <200 40>;
    };
    kp37: keypos@37 {
        compatible = "zmk,key-position-v2";
        #key-cells = <1>;
        key-position = <220 40>;
    };
    kp38: keypos@38 {
        compatible = "zmk,key-position-v2";
        #key-cells = <1>;
        key-position = <240 40>;
    };

    kp39: keypos@39 {
        compatible = "zmk,key-position-v2";
        #key-cells = <1>;
        key-position = <180 65>;
    };
    kp40: keypos@40 {
        compatible = "zmk,key-position-v2";
        #key-cells = <1>;
        key-position = <200 65>;
    };
    kp41: keypos@41 {
        compatible = "zmk,key-position-v2";
        #key-cells = <1>;
        key-position = <220 65>;
    };

     default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <4>;

            // | SW1  | SW2  | SW3  | SW4  | SW5  | SW6  |   | SW6  | SW5  | SW4  | SW3  | SW2  | SW1  |
            // | SW7  | SW8  | SW9  | SW10 | SW11 | SW12 |   | SW12 | SW11 | SW10 | SW9  | SW8  | SW7  |
            // | SW13 | SW14 | SW15 | SW16 | SW17 | SW18 |   | SW18 | SW17 | SW16 | SW15 | SW14 | SW13 |
            // |      |      |      | SW20 | SW21 | SW22 |   | SW22 | SW21 | SW20 |      |      |      |

        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)  RC(0,11) RC(0,10) RC(0,9) RC(0,8) RC(0,7) RC(0,6)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)  RC(1,11) RC(1,10) RC(1,9) RC(1,8) RC(1,7) RC(1,6)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)  RC(2,11) RC(2,10) RC(2,9) RC(2,8) RC(2,7) RC(2,6)
                                    RC(3,3) RC(3,4) RC(3,5)  RC(3,11) RC(3,10) RC(3,9)
            >;
    };

    ergonaut_physical_layout: physical_layout {
        compatible = "zmk,physical-layout";
        display-name = "Ergonaut";

        kscan = <&kscan0>;
        transform = <&default_transform>;

       keys = <
            &kp0 0  &kp1 0  &kp2 0  &kp3 0  &kp4 0  &kp5 0
            &kp6 0  &kp7 0  &kp8 0  &kp9 0  &kp10 0 &kp11 0
            &kp12 0 &kp13 0 &kp14 0 &kp15 0 &kp16 0 &kp17 0
            &kp18 0 &kp19 0 &kp20 0
            &kp21 0 &kp22 0 &kp23 0 &kp24 0 &kp25 0 &kp26 0
            &kp27 0 &kp28 0 &kp29 0 &kp30 0 &kp31 0 &kp32 0
            &kp33 0 &kp34 0 &kp35 0 &kp36 0 &kp37 0 &kp38 0
            &kp39 0 &kp40 0 &kp41 0
        >;
    };
};

&pro_micro_i2c {   
    status = "okay";

    oled: ssd1306@3c {
        compatible = "sinowealth,sh1106";
        reg = <0x3c>;
        width = <128>;
        height = <64>;
        segment-offset = <2>;
        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <63>;
        prechargep = <0x22>;
        inversion-on;
    };
};
