#include "ergonaut_one_nice.dtsi"
#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,physical-layout = &ergonaut_physical_layout;        
        zmk,kscan = &kscan0;
        zmk,matrix_transform = &default_transform;
    };

	    kp0: keypos@0 {
        compatible = "zmk,key-position-v2";
        #key-cells = <1>;
        key-position = <0 0>;
    };
    kp1: keypos@1 {
        compatible = "zmk,key-position-v2";
        #key-cells = <1>;
        key-position = <20 0>;
    };
    kp2: keypos@2 {
        compatible = "zmk,key-position-v2";
        #key-cells = <1>;
        key-position = <40 0>;
    };
    kp3: keypos@3 {
        compatible = "zmk,key-position-v2";
        #key-cells = <1>;
        key-position = <60 0>;
    };
    kp4: keypos@4 {
        compatible = "zmk,key-position-v2";
        #key-cells = <1>;
        key-position = <80 0>;
    };
    kp5: keypos@5 {
        compatible = "zmk,key-position-v2";
        #key-cells = <1>;
        key-position = <100 0>;
    };

    kp6: keypos@6 {
        compatible = "zmk,key-position-v2";
        #key-cells = <1>;
        key-position = <0 20>;
    };
    kp7: keypos@7 {
        compatible = "zmk,key-position-v2";
        #key-cells = <1>;
        key-position = <20 20>;
    };
    kp8: keypos@8 {
        compatible = "zmk,key-position-v2";
        #key-cells = <1>;
        key-position = <40 20>;
    };
    kp9: keypos@9 {
        compatible = "zmk,key-position-v2";
        #key-cells = <1>;
        key-position = <60 20>;
    };
    kp10: keypos@10 {
        compatible = "zmk,key-position-v2";
        #key-cells = <1>;
        key-position = <80 20>;
    };
    kp11: keypos@11 {
        compatible = "zmk,key-position-v2";
        #key-cells = <1>;
        key-position = <100 20>;
    };

    kp12: keypos@12 {
        compatible = "zmk,key-position-v2";
        #key-cells = <1>;
        key-position = <0 40>;
    };
    kp13: keypos@13 {
        compatible = "zmk,key-position-v2";
        #key-cells = <1>;
        key-position = <20 40>;
    };
    kp14: keypos@14 {
        compatible = "zmk,key-position-v2";
        #key-cells = <1>;
        key-position = <40 40>;
    };
    kp15: keypos@15 {
        compatible = "zmk,key-position-v2";
        #key-cells = <1>;
        key-position = <60 40>;
    };
    kp16: keypos@16 {
        compatible = "zmk,key-position-v2";
        #key-cells = <1>;
        key-position = <80 40>;
    };
    kp17: keypos@17 {
        compatible = "zmk,key-position-v2";
        #key-cells = <1>;
        key-position = <100 40>;
    };

    kp18: keypos@18 {
        compatible = "zmk,key-position-v2";
        #key-cells = <1>;
        key-position = <40 65>;
    };
    kp19: keypos@19 {
        compatible = "zmk,key-position-v2";
        #key-cells = <1>;
        key-position = <60 65>;
    };
    kp20: keypos@20 {
        compatible = "zmk,key-position-v2";
        #key-cells = <1>;
        key-position = <80 65>;
    };

    kp21: keypos@21 {
        compatible = "zmk,key-position-v2";
        #key-cells = <1>;
        key-position = <140 0>;
    };
    kp22: keypos@22 {
        compatible = "zmk,key-position-v2";
        #key-cells = <1>;
        key-position = <160 0>;
    };
    kp23: keypos@23 {
        compatible = "zmk,key-position-v2";
        #key-cells = <1>;
        key-position = <180 0>;
    };
    kp24: keypos@24 {
        compatible = "zmk,key-position-v2";
        #key-cells = <1>;
        key-position = <200 0>;
    };
    kp25: keypos@25 {
        compatible = "zmk,key-position-v2";
        #key-cells = <1>;
        key-position = <220 0>;
    };
    kp26: keypos@26 {
        compatible = "zmk,key-position-v2";
        #key-cells = <1>;
        key-position = <240 0>;
    };

    kp27: keypos@27 {
        compatible = "zmk,key-position-v2";
        #key-cells = <1>;
        key-position = <140 20>;
    };
    kp28: keypos@28 {
        compatible = "zmk,key-position-v2";
        #key-cells = <1>;
        key-position = <160 20>;
    };
    kp29: keypos@29 {
        compatible = "zmk,key-position-v2";
        #key-cells = <1>;
