#include "ergonaut_one_nice.dtsi"
#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,physical-layout = &ergonaut_physical_layout;        
        zmk,kscan = &kscan0;
        zmk,matrix_transform = &default_transform;
    };

	kscan0: kscan_0 {
		compatible = "zmk,kscan-gpio-matrix";
		label = "KSCAN";
		wakeup-source;		
        diode-direction = "col2row";
    };

 	kp0: key_position { x = <0>;   y = <0>;   w = <18>; h = <18>; };
    kp1: key_position { x = <20>;  y = <0>;   w = <18>; h = <18>; };
    kp2: key_position { x = <40>;  y = <0>;   w = <18>; h = <18>; };
    kp3: key_position { x = <60>;  y = <0>;   w = <18>; h = <18>; };
    kp4: key_position { x = <80>;  y = <0>;   w = <18>; h = <18>; };
    kp5: key_position { x = <100>; y = <0>;   w = <18>; h = <18>; };

    kp6: key_position { x = <0>;   y = <20>;  w = <18>; h = <18>; };
    kp7: key_position { x = <20>;  y = <20>;  w = <18>; h = <18>; };
    kp8: key_position { x = <40>;  y = <20>;  w = <18>; h = <18>; };
    kp9: key_position { x = <60>;  y = <20>;  w = <18>; h = <18>; };
    kp10: key_position { x = <80>; y = <20>;  w = <18>; h = <18>; };
    kp11: key_position { x = <100>;y = <20>;  w = <18>; h = <18>; };

    kp12: key_position { x = <0>;   y = <40>;  w = <18>; h = <18>; };
    kp13: key_position { x = <20>;  y = <40>;  w = <18>; h = <18>; };
    kp14: key_position { x = <40>;  y = <40>;  w = <18>; h = <18>; };
    kp15: key_position { x = <60>;  y = <40>;  w = <18>; h = <18>; };
    kp16: key_position { x = <80>;  y = <40>;  w = <18>; h = <18>; };
    kp17: key_position { x = <100>; y = <40>;  w = <18>; h = <18>; };

    kp18: key_position { x = <40>;  y = <65>;  w = <18>; h = <18>; };
    kp19: key_position { x = <60>;  y = <65>;  w = <18>; h = <18>; };
    kp20: key_position { x = <80>;  y = <65>;  w = <18>; h = <18>; };

    kp21: key_position { x = <140>; y = <0>;   w = <18>; h = <18>; };
    kp22: key_position { x = <160>; y = <0>;   w = <18>; h = <18>; };
    kp23: key_position { x = <180>; y = <0>;   w = <18>; h = <18>; };
    kp24: key_position { x = <200>; y = <0>;   w = <18>; h = <18>; };
    kp25: key_position { x = <220>; y = <0>;   w = <18>; h = <18>; };
    kp26: key_position { x = <240>; y = <0>;   w = <18>; h = <18>; };

    kp27: key_position { x = <140>; y = <20>;  w = <18>; h = <18>; };
    kp28: key_position { x = <160>; y = <20>;  w = <18>; h = <18>; };
    kp29: key_position { x = <180>; y = <20>;  w = <18>; h = <18>; };
    kp30: key_position { x = <200>; y = <20>;  w = <18>; h = <18>; };
    kp31: key_position { x = <220>; y = <20>;  w = <18>; h = <18>; };
    kp32: key_position { x = <240>; y = <20>;  w = <18>; h = <18>; };

    kp33: key_position { x = <140>; y = <40>;  w = <18>; h = <18>; };
    kp34: key_position { x = <160>; y = <40>;  w = <18>; h = <18>; };
    kp35: key_position { x = <180>; y = <40>;  w = <18>; h = <18>; };
    kp36: key_position { x = <200>; y = <40>;  w = <18>; h = <18>; };
    kp37: key_position { x = <220>; y = <40>;  w = <18>; h = <18>; };
    kp38: key_position { x = <240>; y = <40>;  w = <18>; h = <18>; };

    kp39: key_position { x = <180>; y = <65>;  w = <18>; h = <18>; };
    kp40: key_position { x = <200>; y = <65>;  w = <18>; h = <18>; };
    kp41: key_position { x = <220>; y = <65>;  w = <18>; h = <18>; };


     default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <4>;

            // | SW1  | SW2  | SW3  | SW4  | SW5  | SW6  |   | SW6  | SW5  | SW4  | SW3  | SW2  | SW1  |
            // | SW7  | SW8  | SW9  | SW10 | SW11 | SW12 |   | SW12 | SW11 | SW10 | SW9  | SW8  | SW7  |
            // | SW13 | SW14 | SW15 | SW16 | SW17 | SW18 |   | SW18 | SW17 | SW16 | SW15 | SW14 | SW13 |
            // |      |      |      | SW20 | SW21 | SW22 |   | SW22 | SW21 | SW20 |      |      |      |

        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)  RC(0,11) RC(0,10) RC(0,9) RC(0,8) RC(0,7) RC(0,6)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)  RC(1,11) RC(1,10) RC(1,9) RC(1,8) RC(1,7) RC(1,6)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)  RC(2,11) RC(2,10) RC(2,9) RC(2,8) RC(2,7) RC(2,6)
                                    RC(3,3) RC(3,4) RC(3,5)  RC(3,11) RC(3,10) RC(3,9)
            >;
    };

    ergonaut_physical_layout: physical_layout {
        compatible = "zmk,physical-layout";
        display-name = "Ergonaut";

        kscan = <&kscan0>;
        transform = <&default_transform>;

        keys = <
            &kp0 &kp1 &kp2 &kp3 &kp4 &kp5
            &kp6 &kp7 &kp8 &kp9 &kp10 &kp11
            &kp12 &kp13 &kp14 &kp15 &kp16 &kp17
                   &kp18 &kp19 &kp20
            &kp21 &kp22 &kp23 &kp24 &kp25 &kp26
            &kp27 &kp28 &kp29 &kp30 &kp31 &kp32
            &kp33 &kp34 &kp35 &kp36 &kp37 &kp38
                   &kp39 &kp40 &kp41
        >;
    };
};

&pro_micro_i2c {   
    status = "okay";

    oled: ssd1306@3c {
        compatible = "sinowealth,sh1106";
        reg = <0x3c>;
        width = <128>;
        height = <64>;
        segment-offset = <2>;
        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <63>;
        prechargep = <0x22>;
        inversion-on;
    };
};
